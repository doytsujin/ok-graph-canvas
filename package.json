{
  "name": "@agent-scope-ca/graph-canvas",
  "version": "0.6.0",
  "description": "Semantic Field canvas: weaveworks-derived SVG shape stack, Semantic Link envelope rendering, and a projection registry for laying out the same node set along different control-plane dimensions.",
  "license": "Apache-2.0",
  "author": {
    "name": "Alexander Chernov",
    "url": "https://chernov.ca"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doytsujin/ok-graph-canvas.git"
  },
  "homepage": "https://github.com/doytsujin/ok-graph-canvas#readme",
  "bugs": {
    "url": "https://github.com/doytsujin/ok-graph-canvas/issues"
  },
  "keywords": [
    "graph",
    "canvas",
    "svg",
    "react",
    "d3-force",
    "visualization",
    "topology"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./schema/semantic-field.schema.json": "./schema/semantic-field.schema.json",
    "./gl": {
      "types": "./dist/gl/index.d.ts",
      "import": "./dist/gl/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schema",
    "styles.css",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check": "npm run check:canvas && npm run check:filter && npm run check:trace && npm run check:schema",
    "check:canvas": "esbuild check.ts --bundle --platform=node --format=cjs --outfile=.canvas-check.cjs --log-level=warning && node .canvas-check.cjs",
    "check:filter": "esbuild check-filter.ts --bundle --platform=node --format=cjs --outfile=.filter-check.cjs --log-level=warning && node .filter-check.cjs",
    "check:trace": "esbuild check-trace.ts --bundle --platform=node --format=esm --outfile=.trace-check.mjs --log-level=warning && node .trace-check.mjs",
    "prepublishOnly": "npm run build && npm run check",
    "check:schema": "esbuild check-schema.ts --bundle --platform=node --format=cjs --outfile=.schema-check.cjs --log-level=warning && node .schema-check.cjs",
    "bench": "esbuild bench.ts --bundle --platform=node --format=cjs --outfile=.bench.cjs --log-level=warning && node .bench.cjs",
    "build:wasm": "cd rust/field-layout && wasm-pack build --release --target web --out-dir ../../src/wasm --out-name field_layout && rm -f ../../src/wasm/.gitignore"
  },
  "peerDependencies": {
    "@react-spring/web": ">=9",
    "d3-force": "^3",
    "d3-selection": "^3",
    "d3-shape": "^3",
    "d3-zoom": "^3",
    "lodash-es": "^4",
    "react": ">=18",
    "sigma": ">=3",
    "graphology": ">=0.25"
  },
  "devDependencies": {
    "@react-spring/web": "^9.7.4",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-zoom": "^3.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.2.43",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "^8.20.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "esbuild": "^0.21.5",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "peerDependenciesMeta": {
    "sigma": {
      "optional": true
    },
    "graphology": {
      "optional": true
    }
  }
}
